# ===========================================
# 환경변수 설정 파일 (예시)
# ===========================================
# 이 파일을 복사하여 .env 파일을 만드세요:
#   cp .env.example .env
# 그 후 실제 값을 입력하세요.
#
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!
# ===========================================

# -------------------------------------------
# Bitget API 설정
# -------------------------------------------
BITGET_API_KEY=여기에_API_Key_입력
BITGET_SECRET_KEY=여기에_Secret_Key_입력
BITGET_PASSPHRASE=여기에_Passphrase_입력

# 거래 모드: demo (테스트넷) 또는 live (실거래)
TRADING_MODE=demo

# -------------------------------------------
# Discord Bot 설정
# -------------------------------------------
DISCORD_BOT_TOKEN=여기에_Bot_Token_입력
DISCORD_GUILD_ID=여기에_Server_ID_입력
DISCORD_CHANNEL_ID=여기에_Channel_ID_입력
DISCORD_ADMIN_ID=여기에_Your_User_ID_입력

# -------------------------------------------
# Supabase 설정
# -------------------------------------------
SUPABASE_URL=여기에_Supabase_URL_입력
SUPABASE_KEY=여기에_Supabase_Anon_Key_입력

# -------------------------------------------
# 기타 설정
# -------------------------------------------
# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
